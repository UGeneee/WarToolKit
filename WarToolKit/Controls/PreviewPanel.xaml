<UserControl x:Class="WarToolKit.Controls.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        BorderBrush="Gray"
        BorderThickness="1"
        Padding="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Image Preview -->

            <Border
                Background="#202020"
                CornerRadius="5">

                <Image
                    x:Name="PreviewImage"
                    Stretch="Uniform"/>

            </Border>

            <!-- Information -->

            <StackPanel
                Grid.Row="1"
                Margin="0,10,0,0">

                <TextBlock
                    x:Name="FileNameText"
                    FontWeight="Bold"
                    FontSize="15"/>

                <TextBlock
                    x:Name="ResolutionText"
                    Margin="0,5,0,0"
                    Text="Resolution: Unknown"/>

                <TextBlock
                    x:Name="FormatText"
                    Margin="0,5,0,0"/>

                <TextBlock
                    x:Name="SizeText"
                    Text="Size:"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>