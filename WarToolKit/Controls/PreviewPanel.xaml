<UserControl x:Class="WarToolKit.Controls.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        BorderBrush="Gray"
        BorderThickness="1"
        Padding="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- IMAGE PREVIEW -->
            <!-- ================================================= -->

            <Border
                x:Name="ImagePreviewBorder"
                Background="#202020"
                CornerRadius="5">

                <Image
                    x:Name="PreviewImage"
                    Stretch="Uniform"/>

            </Border>


            <!-- ================================================= -->
            <!-- INFORMATION -->
            <!-- ================================================= -->

            <ScrollViewer
                Grid.Row="1"
                Margin="0,10,0,0"
                VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock
                        x:Name="FileNameText"
                        FontWeight="Bold"
                        FontSize="15"/>


                    <TextBlock
                        x:Name="ResolutionText"
                        Margin="0,5,0,0"
                        Text="Resolution: Unknown"/>


                    <TextBlock
                        x:Name="SizeText"
                        Text="Size:"/>


                    <TextBlock
                        x:Name="FormatText"
                        Margin="0,5,0,0"
                        Text="Format:"/>


                    <!-- ========================================= -->
                    <!-- MODEL INFORMATION -->
                    <!-- ========================================= -->

                    <StackPanel
                        x:Name="ModelInfoPanel"
                        Visibility="Collapsed"
                        Margin="0,15,0,0">

                        <TextBlock
                            Text="MODEL INFORMATION"
                            FontWeight="Bold"
                            FontSize="14"/>


                        <TextBlock
                            x:Name="ModelVersionText"
                            Margin="0,5,0,0"
                            Text="Version:"/>


                        <TextBlock
                            x:Name="ModelTextureCountText"
                            Text="Textures:"/>


                        <TextBlock
                            Text="TEXTURE REFERENCES"
                            FontWeight="Bold"
                            Margin="0,15,0,5"/>


                        <ListBox
    x:Name="ModelTextureList"
    MaxHeight="250"
    SelectionChanged="ModelTextureList_SelectionChanged"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>