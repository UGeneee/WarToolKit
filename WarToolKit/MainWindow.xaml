<Window x:Class="WarToolKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarToolKit"
        mc:Ignorable="d"
        Title="WarToolKit" 
        Height="650" 
        Width="1000">

    <DockPanel>

        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top">

            <Button
                x:Name="OpenFolderButton"
                Width="140"
                Content="📂 Open Folder"
                Click="OpenFolder_Click"/>

            <Separator/>

            <TextBox
                x:Name="SearchBox"
                Width="250"
                Height="24"
                VerticalContentAlignment="Center"/>

        </ToolBar>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="FileCountText"
                           Text="0 Files"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="WarToolkit v0.2"/>
            </StatusBarItem>

        </StatusBar>

        <!-- Main Grid -->
        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="250"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="300"/>

            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0"
                    Margin="5"
                    BorderThickness="1"
                    BorderBrush="Gray">

                <StackPanel Margin="10">

                    <TextBlock
                        FontWeight="Bold"
                        FontSize="18"
                        Text="Folder Information"/>

                    <Separator Margin="0,10"/>

                    <TextBlock
                        x:Name="FolderPathText"
                        Text="No Folder Selected"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Margin="0,15,0,0"
                        x:Name="FolderFileCount"
                        Text="0 Files"/>

                </StackPanel>

            </Border>

            <!-- CENTER PANEL -->

            <Border Grid.Column="1"
                    Margin="5"
                    BorderThickness="1"
                    BorderBrush="Gray">

                <ListView
                    x:Name="FileList"
                    SelectionChanged="FileList_SelectionChanged">

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header="Filename"
                                            Width="350"
                                            DisplayMemberBinding="{Binding Name}"/>

                            <GridViewColumn Header="Extension"
                                            Width="80"
                                            DisplayMemberBinding="{Binding Extension}"/>

                            <GridViewColumn Header="Size"
                                            Width="100"
                                            DisplayMemberBinding="{Binding FormattedFileSize}"/>

                        </GridView>

                    </ListView.View>

                </ListView>

            </Border>

            <!-- RIGHT PANEL -->

            <Border Grid.Column="2"
                    Margin="5"
                    BorderThickness="1"
                    BorderBrush="Gray">

                <StackPanel Margin="10">

                    <TextBlock
                        FontWeight="Bold"
                        FontSize="18"
                        Text="Preview"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="Filename:" FontWeight="Bold"/>

                    <TextBlock x:Name="PreviewFilename"/>

                    <TextBlock Margin="0,15,0,0"
                               Text="Extension:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PreviewExtension"/>

                    <TextBlock Margin="0,15,0,0"
                               Text="File Size:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PreviewSize"/>

                </StackPanel>

            </Border>

        </Grid>

    </DockPanel>
</Window>
