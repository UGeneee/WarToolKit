<Window x:Class="WarToolKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarToolKit"
        mc:Ignorable="d"
        Title="WarToolKit" 
        Height="650" 
        Width="1000">

    <DockPanel>

        <!-- Top Toolbar -->
        <ToolBar DockPanel.Dock="Top">

            <Button
                x:Name="OpenFolderButton"
                Content="📂 Open Folder"
                Width="140"
                Click="OpenFolder_Click"/>

            <Separator/>

            <TextBox
                x:Name="SearchBox"
                Width="250"
                Height="25"/>

        </ToolBar>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>

                <TextBlock
                    x:Name="StatusText"
                    Text="Ready"/>

            </StatusBarItem>

            <Separator/>

            <StatusBarItem>

                <TextBlock
                    x:Name="FileCountText"
                    Text="0 Files"/>

            </StatusBarItem>

            <Separator/>

            <StatusBarItem>

                <TextBlock
                    Text="v0.1.0"/>

            </StatusBarItem>

        </StatusBar>

        <!-- Main Area -->
        <Grid>

            <ListView
                x:Name="FileList">

                <ListView.View>

                    <GridView>

                        <GridViewColumn
                            Header="Filename"
                            Width="350"
                            DisplayMemberBinding="{Binding Name}"/>

                        <GridViewColumn
                            Header="Extension"
                            Width="120"
                            DisplayMemberBinding="{Binding Extension}"/>

                        <GridViewColumn
                            Header="Size (KB)"
                            Width="120"
                            DisplayMemberBinding="{Binding FileSizeKB}"/>

                    </GridView>

                </ListView.View>

            </ListView>

        </Grid>

    </DockPanel>
</Window>
